{
  "name": "mimo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mimo API + realtime game server",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/**/*.test.js",
    "test:tenant": "NODE_ENV=test node --test tests/cross-tenant.test.js",
    "test:match": "NODE_ENV=test node --test tests/match-socket.test.js",
    "lint": "eslint src tests",
    "test:watch": "NODE_ENV=test node --test --watch tests/**/*.test.js",
    "test:learning": "NODE_ENV=test node --test --test-concurrency=1 tests/contest.test.js tests/assignment.test.js tests/review.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "mongoose": "^8.9.2",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1"
  }
}
