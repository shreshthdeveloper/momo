# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
MONGO_URL=mongodb://127.0.0.1:27017/mimo
MONGO_URL_TEST=mongodb://127.0.0.1:27017/mimo_test

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production with the default value.
JWT_SECRET=dev-only-change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Phone numbers granted the superadmin role on first sign-in. Comma-separated,
# E.164 format.
SUPERADMIN_PHONES=+919000000001

# ── SMS ────────────────────────────────────────────────────────────────────
# `console` prints the OTP to the server log instead of sending it. Refused in
# production — set a real provider before deploying.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=TEZAPP
# SMS_ENDPOINT=https://api.msg91.com/api/v5/flow/

# Development-only master OTP, accepted for any number. Ignored outside
# NODE_ENV=development / test.
DEV_MASTER_OTP=000000

# ── CORS ───────────────────────────────────────────────────────────────────
# The Expo dev server.
CORS_ORIGINS=http://localhost:8081

# ── Storage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE=https://cdn.example.com

# ── Push ───────────────────────────────────────────────────────────────────
# Without this, notifications are stored in-app but never pushed.
FCM_SERVER_KEY=

# ── Jobs ───────────────────────────────────────────────────────────────────
ENABLE_JOBS=true

# ── Matchmaking ────────────────────────────────────────────────────────────
# Ghost opponents fill an empty lobby after GHOST_AFTER_MS, and the app never
# says which opponent you got (prd.md F6.7.5) — so with these at their defaults
# there is no way to tell a real rival from a bot.
#
# Set GHOSTS_ENABLED=false to make the queue human-only while testing two real
# devices: each one keeps searching until the other actually arrives, so a match
# is proof they paired. Refused in production. Restart the API after changing it.
# GHOSTS_ENABLED=false
#
# How long to look for a live opponent before serving a ghost. Defaults to 8000.
# Widen it instead of going human-only if you still want the bot as a backstop.
# GHOST_AFTER_MS=30000

# ── Links ──────────────────────────────────────────────────────────────────
APP_LINK_BASE=https://mimo.app

# Object storage (MinIO / S3-compatible)
# STORAGE_DRIVER=minio
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mimo
MINIO_PUBLIC_BASE=
