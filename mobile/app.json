{
  "expo": {
    "name": "Mimo",
    "slug": "mimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mimo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#171422",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mimo.client",
      "infoPlist": {
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:wms.distrx.io"
      ]
    },
    "android": {
      "package": "app.mimo.client",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171422"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wms.distrx.io",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "wms.distrx.io",
              "pathPrefix": "/user"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#171422"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://wms.distrx.io",
      "apiUrlDev": "http://localhost:4000",
      "router": {},
      "eas": {
        "projectId": "39c149c7-6890-4d71-a08c-87d5cb18a70b"
      }
    }
  }
}
