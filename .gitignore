# Node (backend, frontend, mobile)
# ---------------------------------------------------------------------------
node_modules/
.npm/
.eslintcache
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

